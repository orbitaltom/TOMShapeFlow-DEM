    given-names: Luis
    affiliation: "Torres Orbital Mining Inc."
    orcid: "https://orcid.org/0009-0003-2626-6325"
keywords:
  - lunar regolith
  - ISRU
  - DEM
  - particle shape
  - angle of repose
